# Copy to backend/.env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://pm:pm_dev_pw@localhost:5432/pm_dev
# Tests use TEST_DATABASE_URL (must end in _test); destructive test setup refuses anything else.
TEST_DATABASE_URL=postgresql://pm:pm_dev_pw@localhost:5432/pm_test
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# true in production (required); false only for local http
COOKIE_SECURE=false
# Set to the number of reverse proxies in front of the API (e.g. 1) so client IPs are correct for rate limiting.
TRUST_PROXY=false
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
LOG_LEVEL=info
JOBS_ENABLED=true
LOGIN_RATE_LIMIT=10
# Production over plain HTTP (internal network, no TLS) must opt in explicitly:
# ALLOW_INSECURE_HTTP=true
