# O2 Support Hub - server configuration
# install.ps1 creates config\o2.env from this template. Edit o2.env, then restart the service.

NODE_ENV=production
# Port the app listens on. Behind IIS keep it internal (e.g. 4000) and block it in the firewall.
PORT=4000

# PostgreSQL connection. Special characters in the password must be URL-encoded.
DATABASE_URL=postgresql://o2app:CHANGE_ME@localhost:5432/o2_support_hub

# The exact address users type in the browser (scheme + host [+ port]), no trailing slash.
APP_ORIGIN=https://o2.yourcompany.com
CORS_ORIGINS=https://o2.yourcompany.com

# HTTPS (recommended): COOKIE_SECURE=true.
# Plain HTTP on an internal network only: COOKIE_SECURE=false and ALLOW_INSECURE_HTTP=true
COOKIE_SECURE=true
ALLOW_INSECURE_HTTP=false

# Number of reverse proxies in front of the app (IIS = 1). Use false when users connect directly.
TRUST_PROXY=1

# Serve the web app from the same process (leave as is).
SERVE_WEB_DIR=../frontend/dist

# Uploaded files: 'local' = on disk in UPLOAD_DIR (relative to app\backend), 'db' = inside PostgreSQL.
STORAGE_DRIVER=local
UPLOAD_DIR=../../data/uploads
MAX_UPLOAD_MB=20

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_RATE_LIMIT=10

# Background jobs (SLA checks, reminders, notification e-mails)
JOBS_ENABLED=true
LOG_LEVEL=info
APP_NAME=O2 Support Hub

# Optional e-mail (invitations, password resets, notifications). Example for Office 365:
# SMTP_URL=smtp://user%40yourcompany.com:password@smtp.office365.com:587
# MAIL_FROM=O2 Support Hub <support@yourcompany.com>
SMTP_URL=
MAIL_FROM=O2 Support Hub <no-reply@yourcompany.com>
